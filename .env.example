# Local LLM via Ollama -- no API key needed. Install Ollama
# (https://ollama.com/download), then `ollama pull llama3.2` and make sure
# `ollama serve` is running before starting Doraeon.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Hallucination guardrail: minimum cosine similarity (0.0-1.0) the best-retrieved
# chunk must reach before the LLM is asked to answer. Below this, Doraeon refuses
# (strict mode) or falls back to a disclaimed general-knowledge answer (soft mode)
# instead of guessing. Tune to your content -- also adjustable live via the sidebar.
MIN_RETRIEVAL_SCORE=0.35
