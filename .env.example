OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Hallucination guardrail: minimum cosine similarity (0.0-1.0) the best-retrieved
# chunk must reach before the LLM is asked to answer. Below this, Doraeon refuses
# instead of guessing. Tune to your content -- also adjustable live via the sidebar.
MIN_RETRIEVAL_SCORE=0.35
